{
  "name": "landing-kit",
  "version": "0.1.0",
  "description": "Astro 5 + TypeScript + Tailwind v4 starter: OKLCH design tokens, an anti-AI-slop design contract, a deferred GSAP/Canvas motion layer, i18n, hardened contact API, and Coolify+Cloudflare deploy tooling.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --ext .astro,.ts,.tsx,.js",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,js,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=critical",
    "pipeline": "npm run check && npm run lint && npm run test && npm run build && npm run audit"
  },
  "keywords": ["astro", "template", "starter", "design-system", "oklch"],
  "license": "MIT",
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/node": "^9.5.4",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "astro": "^5.17.3",
    "astro-icon": "^1.1.5",
    "gsap": "^3.13.0",
    "lenis": "^1.3.25",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.3",
    "eslint-plugin-astro": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
