# Copy to .env.local for local dev (never commit .env / .env.local / .env.production).

# Contact form email delivery — Microsoft Graph API, client-credentials flow.
# See src/lib/mailer.ts. Swap that file's implementation if you prefer a
# different provider (Resend/Postmark/SES/etc.) — the API route doesn't change.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
CONTACT_EMAIL=

# Google Search Console site-ownership verification (public by design — see
# BaseLayout.astro). Optional.
PUBLIC_GOOGLE_SITE_VERIFICATION=
